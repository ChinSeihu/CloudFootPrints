// schema.prisma —— v1 版本（普通经纬度字段，暂不引入 PostGIS / pgvector）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7：连接 URL 移到 prisma.config.ts（迁移用）+ 运行时用 driver adapter（见 src/lib/db.ts）。
}

enum EventCategory {
  EXHIBITION // 展览
  MARKET     // 市集
  LIVE       // live
  FESTIVAL   // 祭典
  TALK       // 讲座 / 技术活动（connpass 等）
  SPORTS     // 体育 / 运动（马拉松、比赛、健身等）
  OTHER      // 其他 / 兜底
}

enum SourceType {
  OFFICIAL_API
  OFFICIAL_WEB
  SOCIAL // 预留，v1 不使用
  USER   // 用户发布
}

enum ReactionType {
  LIKE     // 点赞
  FAVORITE // 收藏
  SIGNUP   // 报名（仅当 Event.signupEnabled 时有意义）
}

// 抓取的官方活动（只读）。用户发帖见 Post。userId/tags/signupEnabled/多图 是发帖专属，已迁出。
model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  summary     String?       // LLM 生成的一句话摘要（≤14 字，地图标签用）
  category    EventCategory
  venueName   String?
  address     String?
  imageUrl    String?       // 封面图 URL（LLM 抽取/卡片/地图用）
  lat         Float
  lng         Float
  startTime   DateTime?
  endTime     DateTime?

  sourceType  SourceType
  sourceUrl   String?
  trustLevel  Int           @default(0) // 官方高、社交低
  rawText     String?       // 保留原始文本，便于以后重新解析

  checkIns    CheckIn[]
  comments    Comment[]
  reactions   Reaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // v1 用 lat/lng 做矩形范围查询即可，加索引
  @@index([lat, lng])
  @@index([startTime])
  @@index([category])
  // TODO(v2+): 增加 geom(PostGIS geometry) 与 embedding(pgvector) 字段
}

// 用户发帖（"这里有个活动"）。与抓取的官方活动 Event 分表存储：
// Post = 用户生产内容（可编辑/删除、带作者、可多图、可报名）；Event = 官方抓取（只读、带来源元数据）。
// 地图/推荐读路径把两表并起来统一成 EventDTO（Post 映射为 sourceType="USER"）。
model Post {
  id            String        @id @default(cuid())
  title         String
  description   String?
  category      EventCategory
  venueName     String?
  imageUrl      String?       // 封面图（= imageUrls[0]）
  imageUrls     String[]      @default([]) // 多图
  lat           Float
  lng           Float
  startTime     DateTime?
  endTime       DateTime?
  tags          String[]      @default([])
  signupEnabled Boolean       @default(false)
  userId        String        // 作者（User.id）。发帖必有作者。

  checkIns      CheckIn[]
  comments      Comment[]
  reactions     Reaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([lat, lng])
  @@index([userId, createdAt])
  @@index([startTime])
  @@index([category])
}

// 美食 POI（来源 OpenStreetMap / Overpass）。常驻地点，按地图视野查询 + 聚合显示。
// 与「精选名店 + Hot Pepper」(静态 foodSpots) 互补：OSM 提供全量底图，精选作亮点叠加。
model FoodPoi {
  id           String   @id @default(cuid())
  osmType      String   // node / way / relation
  osmId        String   // OSM 元素 id
  name         String
  nameEn       String?
  kind         String   // FoodKind：japanese/chinese/western/cafe/dessert/other
  cuisine      String?  // 原始 cuisine 标签（如 italian;pizza）
  lat          Float
  lng          Float
  openingHours String?
  phone        String?
  website      String?
  takeaway     Boolean  @default(false)
  wheelchair   Boolean  @default(false)
  address      String?
  updatedAt    DateTime @updatedAt

  @@unique([osmType, osmId])
  @@index([lat, lng])
  @@index([kind])
}

// Hot Pepper Gourmet API 全量东京餐厅（按视野懒加载展示）。id 用 Hot Pepper 店铺 id 天然去重。
model HotPepperPoi {
  id        String   @id // Hot Pepper shop id
  name      String
  kind      String // FoodKind：japanese/chinese/western/cafe/dessert/other
  genre     String? // 细分菜系名
  lat       Float
  lng       Float
  budget    String? // 参考人均
  station   String? // 最寄駅
  open      String? // 营业时间
  catchText String? // 招牌语（catch）
  address   String?
  photo     String? // 店铺照片
  url       String? // Hot Pepper 店铺页
  amenities String[] @default([]) // 個室/禁煙席/Wi-Fi/カード可/ランチ
  updatedAt DateTime @updatedAt

  @@index([lat, lng])
  @@index([kind])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String   @default("me") // v1 单用户，固定为本人；v2 接入真实用户
  // 可选关联到地图上已有的目标：官方活动 eventId 或用户发帖 postId（二选一）
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  lat       Float
  lng       Float
  note      String?
  photoUrl  String?  // 封面照片（= photoUrls[0]，向后兼容）
  photoUrls String[] @default([]) // 多张打卡照片
  rating    Int? // legacy primary mood tag
  moodTags  Int[] @default([]) // selected mood tag values
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  // 评论目标：官方活动 eventId 或用户发帖 postId（二选一），各自级联删除。
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @default("me") // v1 单用户；v2 接入真实用户
  text      String
  parentId  String? // 回复的目标评论（顶层评论为 null）
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([postId, createdAt])
  @@index([parentId])
}

// 点赞 / 收藏：用户↔活动。一张表 + type 区分，唯一约束防重复。
// userId 存 User.id（旧 "me" 数据不会产生 Reaction）。删活动时级联清理。
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  // 目标：官方活动 eventId 或用户发帖 postId（二选一），各自级联删除。
  eventId   String?
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([userId, eventId, type])
  @@unique([userId, postId, type])
  @@index([eventId, type])
  @@index([postId, type])
  @@index([userId, type])
}

model EventMetric {
  eventId    String   @id
  clickCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// v2：本地账号（用户名 + 口令哈希）。CheckIn/Comment/Event 的 userId 存本表 id（旧数据沿用 "me"，不加外键以免破坏）。
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  signature    String? // 个性签名
  avatarUrl    String? // 头像（Cloudinary URL）
  coverUrl     String? // 资料卡背景图（Cloudinary URL）
  hometown     String? // 常住地（可选）
  status       String? // 状态 / 心情
  lastLoginAt  DateTime? // 最后登录时间（每次建立会话时更新）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── 社区模拟（V7）：记忆 / 状态 / 关系。仅服务后台模拟，不直接对外展示。 ──
  memories     Memory[]
  charState    CharacterState?
  relationsA   Relationship[]  @relation("relA")
  relationsB   Relationship[]  @relation("relB")
}

// ───────────────────────── 社区模拟（V7 Agent Architecture）─────────────────────────
// 设计见 docs/Agent_Architecture.md。这些表是「记忆→关系→行为→内容」的内部状态，
// 与对外内容表（CheckIn/Post/Comment）分离；内容只是模拟的副产物。

enum MemoryType {
  EVENT // 普通经历（多由足迹回填/生成）
  RELATIONSHIP // 与某人相关的记忆
  MILESTONE // 重大人生事件
  GOAL // 目标 / 意图
  SUMMARY // 记忆压缩后的生活摘要（每 30 天）
}

// 角色记忆：检索优先级 = 关系 > 近期 > 重大 > 目标；importance + decayAt 实现衰减/压缩。
model Memory {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  type            MemoryType @default(EVENT)
  importance      Int        @default(1) // 1..3
  happenedAt      DateTime   @default(now()) // 记忆「发生」的时间（可回填为过去）
  decayAt         DateTime? // 到期后可被压缩/淡出（null = 长期保留）
  sourceCheckInId String? // 若由某条足迹回填而来，便于追溯/去重
  createdAt       DateTime   @default(now())

  @@index([userId, happenedAt])
  @@index([userId, importance])
}

// 角色当前状态：情绪（jsonb 0–100）/ 目标 / 人生阶段。每个 demo 用户一行。
model CharacterState {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion      Json      @default("{}") // { stress, loneliness, excitement, satisfaction, ... } 0–100
  goals        String[]  @default([])
  lifeStage    String?
  cast         Json      @default("[]") // 系统外的常出现熟人名册 [{name, relation}]，让"又见到某人"有连续性
  lastActiveAt DateTime? // 最后产出内容时间（Community Agent 用来保证每人每周露面）
  updatedAt    DateTime  @updatedAt
}

// 弱连接关系：成长慢、自然衰减；(aId,bId) 规范化为 aId<bId 唯一。
model Relationship {
  id             String    @id @default(cuid())
  aId            String
  a              User      @relation("relA", fields: [aId], references: [id], onDelete: Cascade)
  bId            String
  b              User      @relation("relB", fields: [bId], references: [id], onDelete: Cascade)
  strength       Int       @default(0) // 0..100
  sentiment      Int       @default(0) // -100..100
  lastInteractAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

// 世界状态：每天一行（东京当天的季节/天气/城市情绪/热点）。
model WorldState {
  date        String   @id // YYYY-MM-DD（东京时区）
  season      String
  weather     String
  cityMood    String
  viralTopics Json     @default("[]")
  createdAt   DateTime @default(now())
}
