// schema.prisma —— v1 版本（普通经纬度字段，暂不引入 PostGIS / pgvector）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7：连接 URL 移到 prisma.config.ts（迁移用）+ 运行时用 driver adapter（见 src/lib/db.ts）。
}

enum EventCategory {
  EXHIBITION // 展览
  MARKET     // 市集
  LIVE       // live
  FESTIVAL   // 祭典
  TALK       // 讲座 / 技术活动（connpass 等）
  SPORTS     // 体育 / 运动（马拉松、比赛、健身等）
  OTHER      // 其他 / 兜底
}

enum SourceType {
  OFFICIAL_API
  OFFICIAL_WEB
  SOCIAL // 预留，v1 不使用
  USER   // 用户发布
}

enum ReactionType {
  LIKE     // 点赞
  FAVORITE // 收藏
  SIGNUP   // 报名（仅当 Event.signupEnabled 时有意义）
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  summary     String?       // LLM 生成的一句话摘要（≤14 字，地图标签用）
  category    EventCategory
  venueName   String?
  address     String?
  imageUrl    String?       // 封面图 URL（= imageUrls[0]；LLM 抽取/卡片/地图用）
  imageUrls   String[]      @default([]) // 多图（用户发帖可传多张；抓取来源一般为空）
  lat         Float
  lng         Float
  startTime   DateTime?
  endTime     DateTime?

  sourceType  SourceType
  sourceUrl   String?
  trustLevel  Int           @default(0) // 官方高、用户/社交低
  rawText     String?       // 保留原始文本，便于以后重新解析
  userId      String?       // USER 发帖的作者（User.id）；抓取来源为 null
  tags        String[]      @default([]) // 活动标签（用户发帖填写；抓取来源为空，展示时按关键词派生）
  signupEnabled Boolean     @default(false) // 是否开启报名（用户发帖可选）

  checkIns    CheckIn[]
  comments    Comment[]
  reactions   Reaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // v1 用 lat/lng 做矩形范围查询即可，加索引
  @@index([lat, lng])
  @@index([startTime])
  @@index([category])
  // TODO(v2+): 增加 geom(PostGIS geometry) 与 embedding(pgvector) 字段
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String   @default("me") // v1 单用户，固定为本人；v2 接入真实用户
  eventId   String? // 可选：关联到地图上已有的活动
  event     Event?   @relation(fields: [eventId], references: [id])
  lat       Float
  lng       Float
  note      String?
  photoUrl  String?  // 封面照片（= photoUrls[0]，向后兼容）
  photoUrls String[] @default([]) // 多张打卡照片
  rating    Int? // 1–5
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @default("me") // v1 单用户；v2 接入真实用户
  text      String
  parentId  String? // 回复的目标评论（顶层评论为 null）
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([parentId])
}

// 点赞 / 收藏：用户↔活动。一张表 + type 区分，唯一约束防重复。
// userId 存 User.id（旧 "me" 数据不会产生 Reaction）。删活动时级联清理。
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([userId, eventId, type])
  @@index([eventId, type])
  @@index([userId, type])
}

// v2：本地账号（用户名 + 口令哈希）。CheckIn/Comment/Event 的 userId 存本表 id（旧数据沿用 "me"，不加外键以免破坏）。
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  signature    String? // 个性签名
  avatarUrl    String? // 头像（Cloudinary URL）
  coverUrl     String? // 资料卡背景图（Cloudinary URL）
  hometown     String? // 常住地（可选）
  status       String? // 状态 / 心情
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
