# ---- 数据库（v1：云端免费 Postgres，如 Neon / Supabase）----
# Neon: https://neon.tech  |  Supabase: https://supabase.com
# 复制本文件为 .env 后，把下面替换成你的连接串。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- LLM（结构化提取用，可切换 provider）----
# deepseek（或任意 OpenAI 兼容端点）：用 JSON 模式
#   LLM_PROVIDER="deepseek"  LLM_MODEL="deepseek-chat"  LLM_BASE_URL="https://api.deepseek.com"
# anthropic（Claude）：用 tool use
#   LLM_PROVIDER="anthropic" LLM_MODEL="claude-haiku-4-5"（LLM_BASE_URL 留空）
LLM_PROVIDER="deepseek"
LLM_API_KEY=""                 # 对应 provider 的 API key（anthropic 也可用 ANTHROPIC_API_KEY）
LLM_MODEL="deepseek-chat"
LLM_BASE_URL="https://api.deepseek.com"

# ---- 地图底图（CARTO Positron，免费）----
NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"

# ---- 数据源（可选 key；缺失时对应源会跳过）----
# 东京都开放数据目录（CKAN）。填一个含活动信息的 resource id 即可启用该源。
TOKYO_OPENDATA_RESOURCE_ID=""
# connpass API v2 key（https://connpass.com/about/api/）。缺失时 connpass 源跳过。
CONNPASS_API_KEY=""

# 地理编码用国土地理院（GSI）免费 API，无需 key。
