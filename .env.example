# ---- 数据库（v1：云端免费 Postgres，如 Neon / Supabase）----
# Neon: https://neon.tech  |  Supabase: https://supabase.com
# 复制本文件为 .env 后，把下面替换成你的连接串。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- 会话签名密钥（用户登录 JWT）----
# 生产务必改成随机长串（如 `openssl rand -base64 32`）。本地留空则用内置开发默认（不安全，仅自用）。
AUTH_SECRET=""

# ---- LLM（结构化提取用，可切换 provider）----
# deepseek（或任意 OpenAI 兼容端点）：用 JSON 模式
#   LLM_PROVIDER="deepseek"  LLM_MODEL="deepseek-chat"  LLM_BASE_URL="https://api.deepseek.com"
# anthropic（Claude）：用 tool use
#   LLM_PROVIDER="anthropic" LLM_MODEL="claude-haiku-4-5"（LLM_BASE_URL 留空）
LLM_PROVIDER="deepseek"
LLM_API_KEY=""                 # 对应 provider 的 API key（anthropic 也可用 ANTHROPIC_API_KEY）
LLM_MODEL="deepseek-chat"
LLM_BASE_URL="https://api.deepseek.com"

# 用 LLM 给抓取到的活动重判分类（比关键词准，OTHER 更少）。
# 需要上面的 LLM_API_KEY；关闭或缺 key 时回退关键词分类（零成本）。
CLASSIFY_WITH_LLM="true"

# GSI 地理编码失败时（多因地址含建筑名/设施名），用 LLM 把地址规范成标准住所后重试。
# 需要上面的 LLM_API_KEY；只对失败的地址调用，省成本。东京边界校验兜底 LLM 幻觉。
GEOCODE_LLM_FALLBACK="false"

# ---- 地图底图（CARTO Positron，免费）----
NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"

# ---- 图床（Cloudinary，发帖贴图用；都是可公开的值，非密钥）----
# Cloudinary → Settings → Upload → 新建一个 Unsigned upload preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
# 定时清理图床时使用的服务端管理凭据（只放本地环境或 GitHub Secrets，绝不能暴露给浏览器）。
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_CLEANUP_PREFIX="cloudfootprints/"

# ---- 社区模拟人物配图（Phase 4，可选）----
# IMAGE_PROVIDER：none（默认，不出图）| gemini（Google Gemini 2.5 Flash Image）| agnes。
# 生成图会自动上传上面的 Cloudinary（自带 CORS、持久）。provider 失败/无额度时不出图、不影响模拟。
IMAGE_PROVIDER="none"
# gemini：去 AI Studio 申请 key（需有 billing 额度）。鉴权用 x-goog-api-key 头。
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# agnes（OpenAI images 兼容，已接入）：base URL + key + 图像模型。
AGNES_API_URL="https://apihub.agnes-ai.com/v1"
AGNES_API_KEY=""
AGNES_MODEL="agnes-image-2.1-flash"
# 视觉质检（用多模态 chat 看生成图，不合格自动改 prompt 重生成）。默认开；置 false 关闭省钱。
IMAGE_QA="true"
IMAGE_QA_RETRIES="2"
IMAGE_QA_MODEL="agnes-2.0-flash"

# ---- 数据源（可选 key；缺失时对应源会跳过）----
# walkerplus 东京全域列表抓取页数（每页约 10 个；默认 8≈80 个，范围 1-20）。
WALKERPLUS_MAX_PAGES="8"
# 东京都开放数据目录（CKAN）。填一个含活动信息的 resource id 即可启用该源。
TOKYO_OPENDATA_RESOURCE_ID=""
# connpass API v2 key（https://connpass.com/about/api/）。缺失时 connpass 源跳过。
CONNPASS_API_KEY=""

# 地理编码用国土地理院（GSI）免费 API，无需 key。

# ---- 车站时刻表（ODPT 公共交通开放数据中心，免费需注册）----
# 申请：https://www.odpt.org/ → 开发者注册拿 Access Token。缺失时车站「时刻表」按钮返回空。
ODPT_API_KEY=""
